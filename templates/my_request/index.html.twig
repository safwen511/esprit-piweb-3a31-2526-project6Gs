{% extends 'base.html.twig' %}

{% block title %}{{ 'my_requests.title'|trans }}{% endblock %}

{% block body %}
    <style>
        body { background: #f8fafc; }
        .requests-shell { max-width: 1040px; margin: 2rem auto; padding: 0 1rem 2.5rem; }
        .requests-shell h1 { margin-bottom: 0.4rem; }
        .requests-shell > p { color: #475569; margin-bottom: 1.5rem; }
        .request-list { display: grid; gap: 1rem; }
        .request-card { background: #fff; border-radius: 18px; padding: 1.25rem 1.35rem; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08); border: 1px solid #e2e8f0; }
        .request-top { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
        .request-title { margin: 0; font-size: 1.1rem; color: #0f172a; }
        .status-badge { border-radius: 999px; padding: 0.35rem 0.72rem; font-size: 0.82rem; font-weight: 700; }
        .status-pending { background: #fef3c7; color: #92400e; }
        .status-approved { background: #dcfce7; color: #166534; }
        .status-declined { background: #fee2e2; color: #b91c1c; }
        .request-card p { margin: 0.55rem 0 0; color: #475569; }
        .request-actions { margin-top: 1rem; display: flex; gap: 0.7rem; flex-wrap: wrap; }
        .action-link,
        .action-button,
        .action-disabled { border-radius: 999px; padding: 0.72rem 1rem; font: inherit; text-decoration: none; }
        .action-link { background: #2563eb; color: #fff; }
        .action-button { background: #ef4444; color: #fff; border: none; cursor: pointer; }
        .action-disabled { background: #e2e8f0; color: #64748b; cursor: not-allowed; }
        .empty-state { background: #fff; border-radius: 18px; padding: 2rem; text-align: center; color: #64748b; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08); }
    </style>

    <div class="requests-shell">
        <h1>{{ 'my_requests.title'|trans }}</h1>
        <p>{{ 'my_requests.subtitle'|trans }}</p>

        {% if requests is not empty %}
            <div class="request-list">
                {% for requestItem in requests %}
                    {% set statusValue = requestItem.status ?: 'PENDING' %}
                    {% set statusClass = statusValue == 'APPROVED' ? 'status-approved' : (statusValue == 'REJECTED' ? 'status-declined' : 'status-pending') %}
                    {% set statusLabel = ('status.' ~ statusValue|lower)|trans %}
                    <article class="request-card">
                        <div class="request-top">
                            <h2 class="request-title">{{ requestItem.animal ? requestItem.animal.name : ('my_requests.unknown_animal'|trans) }}</h2>
                            <span class="status-badge {{ statusClass }}">{{ statusLabel }}</span>
                        </div>
                        <p><strong>{{ 'labels.owner'|trans }}:</strong> {{ requestItem.animal and requestItem.animal.owner ? requestItem.animal.owner.username : ('my_requests.no_owner'|trans) }}</p>
                        <p><strong>{{ 'labels.date'|trans }}:</strong> {{ requestItem.requestDate ? requestItem.requestDate|date('Y-m-d H:i') : ('labels.not_provided'|trans) }}</p>

                        <div class="request-actions">
                            {% if statusValue == 'PENDING' %}
                                <a href="{{ path('my_requests_edit', {id: requestItem.id}) }}" class="action-link">{{ 'actions.edit'|trans }}</a>
                                <form method="post" action="{{ path('my_requests_delete', {id: requestItem.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('my-request-delete-' ~ requestItem.id) }}">
                                    <button type="submit" class="action-button">{{ 'actions.delete'|trans }}</button>
                                </form>
                            {% else %}
                                <span class="action-disabled">{{ 'actions.edit'|trans }}</span>
                                <span class="action-disabled">{{ 'actions.delete'|trans }}</span>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                {{ 'my_requests.empty'|trans }}
            </div>
        {% endif %}
    </div>
{% endblock %}
