{% extends 'base.html.twig' %}

{% block title %}Planning Veterinaire{% endblock %}

{% block body %}
<section class="page-panel">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success mb-4">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger mb-4">{{ message }}</div>
    {% endfor %}

    <div class="page-header">
        <div>
            <h1 class="page-title">Planning professionnel</h1>
            <p class="page-subtitle">Planifiez vos seminaires, programmes, indisponibilites et visualisez vos rendez-vous confirmes dans un calendrier unique.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header">Calendrier</div>
                <div class="card-body p-4">
                    <div id="calendar-holder"></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-header">Nouvel evenement</div>
                <div class="card-body p-4">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.title) }}
                            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.title) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.eventType) }}
                            {{ form_widget(form.eventType, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.eventType) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.startsAt) }}
                            {{ form_widget(form.startsAt, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.startsAt) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.endsAt) }}
                            {{ form_widget(form.endsAt, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.endsAt) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            {{ form_errors(form.description) }}
                        </div>
                        {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary w-100'}}) }}
                    {{ form_end(form) }}
                </div>
            </div>

            <div class="card">
                <div class="card-header">Evenements enregistres</div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        {% for event in planningEvents %}
                            <div class="list-group-item border-0 border-bottom px-4 py-3">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <div class="fw-semibold mb-1">{{ event.title }}</div>
                                        <div class="small text-muted mb-1">{{ event.eventType|title }}</div>
                                        <div class="small text-muted">
                                            {{ event.startsAt|date('d/m/Y H:i') }}{% if event.endsAt %} - {{ event.endsAt|date('d/m/Y H:i') }}{% endif %}
                                        </div>
                                        {% if event.description %}
                                            <div class="small mt-2">{{ event.description }}</div>
                                        {% endif %}
                                    </div>
                                    <form method="post" action="{{ path('vet_calendar_delete', {id: event.id}) }}">
                                        <button class="btn btn-sm btn-outline-secondary" onclick="return confirm('Supprimer cet evenement ?')">Supprimer</button>
                                    </form>
                                </div>
                            </div>
                        {% else %}
                            <div class="empty-state">Aucun evenement personnel n a encore ete enregistre.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar-holder');
            if (!calendarEl) {
                return;
            }

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                height: 720,
                headerToolbar: {
                    start: 'prev,next today',
                    center: 'title',
                    end: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                eventSources: [{
                    url: '{{ path('fc_load_events') }}',
                    method: 'POST',
                    extraParams: {
                        filters: JSON.stringify({})
                    },
                    failure: function () {
                        alert('Le calendrier n a pas pu etre charge.');
                    }
                }],
                eventClick: function (info) {
                    const description = info.event.extendedProps.description || 'Aucune description disponible';
                    alert(info.event.title + '\n' + description);
                }
            });

            calendar.render();
        });
    </script>
{% endblock %}
