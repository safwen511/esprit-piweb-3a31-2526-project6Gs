{% extends 'base.html.twig' %}

{% block title %}{{ animal.name }} {{ 'animal.show.details_suffix'|trans }}{% endblock %}

{% block body %}
    <section class="detail-layout">
        <article class="detail-card">
            <img class="animal-image-large" src="{{ animal.image ? asset('images/' ~ animal.image) : 'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=1200&q=80' }}" alt="{{ animal.name }}">
        </article>
        <aside class="detail-info">
            <h1>{{ animal.name }}</h1>
            <div class="detail-meta">
                <p><strong>{{ 'labels.species'|trans }}:</strong> {{ animal.type }}</p>
                <p><strong>{{ 'labels.breed'|trans }}:</strong> {{ animal.breed ?: ('labels.na'|trans) }}</p>
                <p><strong>{{ 'labels.age'|trans }}:</strong> {{ animal.formattedAge ?: ('labels.na'|trans) }}</p>
                <p><strong>{{ 'labels.gender'|trans }}:</strong> {{ animal.gender ? ('gender.' ~ animal.gender|lower)|trans : ('labels.na'|trans) }}</p>
                <p><strong>{{ 'labels.status'|trans }}:</strong> {{ animal.status ? ('status.' ~ animal.status|lower)|trans : ('labels.na'|trans) }}</p>
                <p><strong>{{ 'labels.description'|trans }}:</strong> {{ animal.description ?: ('animal.show.no_description'|trans) }}</p>
                <p><strong>{{ 'labels.owner'|trans }}:</strong> {{ animal.owner ? animal.owner.username : ('animal.show.no_owner'|trans) }}</p>
            </div>
            <div class="actions" style="margin-top: 22px;">
                <a href="{{ path('animal_adopt', {id: animal.id}) }}" class="button">{{ 'animal.show.adopt_me'|trans }}</a>
                <a href="{{ currentUserId ? path('animal_index', {userId: currentUserId}) : path('animal_index_default') }}" class="button secondary">{{ 'actions.back_to_catalog'|trans }}</a>
            </div>
        </aside>
    </section>
{% endblock %}
