{% extends 'base.html.twig' %}

{% block title %}Shop{% endblock %}

{% block body %}
    {% set featured = products|length > 0 ? random(products) : null %}

    <section class="hero">
        <div class="hero__visual">
            {% if featured and featured.image and (featured.image starts with 'uploads/' or featured.image starts with 'http') %}
                <img src="{% if featured.image starts with 'http' %}{{ featured.image }}{% else %}/{{ featured.image }}{% endif %}" alt="{{ featured.title }}">
            {% endif %}
        </div>

        <div class="hero__copy">
            <span class="hero__eyebrow">Best seller</span>
            <h1 class="hero__title">
                {{ featured ? featured.title : 'FurHope' }}
                <span>{{ featured ? featured.categoryLabel : 'Best seller' }}</span>
            </h1>
            <p class="hero__description">
                {% if featured %}
                    Current pick: <strong>{{ featured.title }}</strong> for <strong>{{ (featured.price - featured.tva)|number_format(2, '.', ' ') }} TND</strong> with {{ featured.stock }} items left in stock.
                {% endif %}
            </p>
            <div class="hero__cta">
                <a class="button" href="#catalog">Discover products</a>
                {% if can_manage_products %}
                    <a class="button ghost" href="{{ path('app_shop_item_new') }}">Add a new product</a>
                {% else %}
                    <a class="button ghost" href="{{ path('app_cart') }}">Open cart</a>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="category-row">
        {% for key, label in categories %}
            {% set categoryImage = null %}
            {% for product in products %}
                {% if categoryImage is null and product.category == key and product.image and (product.image starts with 'uploads/' or product.image starts with 'http') %}
                    {% set categoryImage = product.image starts with 'http' ? product.image : '/' ~ product.image %}
                {% endif %}
            {% endfor %}

            <a class="category-pill" href="{{ path('app_shop', {category: key}) }}">
                <span class="category-pill__media">
                    {% if categoryImage %}
                        <img src="{{ categoryImage }}" alt="{{ label }}">
                    {% else %}
                        {{ label|slice(0, 2) }}
                    {% endif %}
                </span>
                <span class="category-pill__content">
                    <strong>{{ label }}</strong>
                    <small>Browse {{ label|lower }} items</small>
                </span>
            </a>
        {% endfor %}
    </section>

    <section class="panel">
        <div class="section-heading">
            <div>
                <h2>Find the right item</h2>
            </div>
        </div>

        <form method="get" action="{{ path('app_shop') }}" class="filters" id="shop-filters">
            {% if filters.category != 'all' %}
                <input type="hidden" name="category" value="{{ filters.category }}">
            {% endif %}
            <div class="field">
                <label for="q">Search by name</label>
                <input id="q" type="text" name="q" value="{{ filters.q }}" autocomplete="off" placeholder="Search products">
            </div>
            <div class="field">
                <label for="min_price">Min price</label>
                <input id="min_price" type="number" step="0.01" min="0" name="min_price" value="{{ filters.min_price }}" placeholder="0.00">
            </div>
            <div class="field">
                <label for="max_price">Max price</label>
                <input id="max_price" type="number" step="0.01" min="0" name="max_price" value="{{ filters.max_price }}" placeholder="999.99">
            </div>
            <div class="full actions">
                <button class="button" type="submit">Apply filters</button>
                <a class="button secondary" href="{{ path('app_shop') }}">Reset</a>
            </div>
        </form>
    </section>

    <div id="shop-catalog" class="catalog-shell">
        {{ include('shop/_catalog.html.twig', {
            products: products,
            cart_quantities: cart_quantities,
            can_manage_products: can_manage_products
        }) }}
    </div>

    <script>
        (function () {
            const form = document.getElementById('shop-filters');
            const catalog = document.getElementById('shop-catalog');
            if (!form) {
                return;
            }

            const searchInput = form.querySelector('input[name="q"]');
            const autoSubmitFields = form.querySelectorAll('input[name="min_price"], input[name="max_price"]');
            let timeoutId = null;
            let activeController = null;

            const buildUrl = function () {
                const formData = new FormData(form);
                const params = new URLSearchParams();

                formData.forEach(function (value, key) {
                    if (typeof value === 'string' && value.trim() !== '') {
                        params.set(key, value);
                    }
                });

                const query = params.toString();
                const baseUrl = form.getAttribute('action') || window.location.pathname;

                return query === '' ? baseUrl : baseUrl + '?' + query;
            };

            const submitForm = function () {
                if (!catalog) {
                    form.requestSubmit();
                    return;
                }

                const url = buildUrl();

                if (activeController !== null) {
                    activeController.abort();
                }

                activeController = new AbortController();
                catalog.classList.add('is-loading');

                window.fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    signal: activeController.signal
                })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('Request failed');
                        }

                        return response.text();
                    })
                    .then(function (html) {
                        catalog.innerHTML = html;
                        window.history.replaceState({}, '', url);
                    })
                    .catch(function (error) {
                        if (error.name !== 'AbortError') {
                            window.location.assign(url);
                        }
                    })
                    .finally(function () {
                        catalog.classList.remove('is-loading');
                    });
            };

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                submitForm();
            });

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    window.clearTimeout(timeoutId);
                    timeoutId = window.setTimeout(submitForm, 250);
                });
            }

            autoSubmitFields.forEach(function (field) {
                field.addEventListener('change', submitForm);
                if (field.tagName === 'INPUT') {
                    field.addEventListener('input', function () {
                        window.clearTimeout(timeoutId);
                        timeoutId = window.setTimeout(submitForm, 250);
                    });
                }
            });
        })();
    </script>
{% endblock %}
