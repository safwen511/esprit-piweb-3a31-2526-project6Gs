{% extends 'base.html.twig' %}

{% block title %}Hotel Details{% endblock %}

{% block body %}
    <div class="form-shell">
        <div class="section-heading">
            <h1>Hotel Details</h1>
        </div>

        <form method="post" action="{{ path('app_hotel_update', {'id': hotel.id}) }}">
            <div class="form-grid">
                <div class="field">
                    <label>ID</label>
                    <input type="text" value="{{ hotel.id }}" readonly>
                </div>
                <div class="field">
                    <label>Name</label>
                    <input type="text" name="hotel[name]" value="{{ hotel.name }}" required>
                </div>
                <div class="field">
                    <label>Address</label>
                    <input type="text" name="hotel[address]" value="{{ hotel.address }}" required>
                </div>
                <div class="field">
                    <label>Manager ID</label>
                    <input type="number" name="hotel[managerId]" value="{{ hotel.managerId ?? '' }}">
                </div>
                <div class="field">
                    <label>Capacity</label>
                    <input type="number" name="hotel[capacity]" value="{{ hotel.capacity ?? '' }}">
                </div>
            </div>

            <div class="actions">
                <button class="button" type="submit">Save</button>
                {{ include('hotel/_delete_form.html.twig') }}
                <a class="button secondary" href="{{ path('app_hotel_index') }}">Back to list</a>
            </div>
        </form>
    </div>
{% endblock %}