<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion | FurHope</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        :root {
            --fh-bg: #f5f0e8;
            --fh-surface: rgba(255, 253, 250, 0.95);
            --fh-border: #e7d7c4;
            --fh-primary: #d28445;
            --fh-primary-dark: #b96b30;
            --fh-text: #2f261f;
            --fh-muted: #7c6c5f;
            --fh-danger-bg: #f9e7e5;
            --fh-danger-text: #8f3e38;
            --fh-shadow: 0 24px 50px rgba(71, 48, 28, 0.10);
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at top left, rgba(210, 132, 69, 0.12), transparent 30%),
                linear-gradient(180deg, #f8f3eb 0%, var(--fh-bg) 60%, #efe7db 100%);
            color: var(--fh-text);
            font-family: Georgia, 'Times New Roman', serif;
            padding: 24px;
        }

        .login-shell {
            width: 100%;
            max-width: 1040px;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            background: var(--fh-surface);
            border: 1px solid rgba(231, 215, 196, 0.9);
            border-radius: 32px;
            overflow: hidden;
            box-shadow: var(--fh-shadow);
        }

        .login-brand {
            padding: 56px 52px;
            background:
                linear-gradient(160deg, rgba(210, 132, 69, 0.12), rgba(255, 255, 255, 0.08)),
                linear-gradient(180deg, #f7efe5 0%, #f3e8d9 100%);
            border-right: 1px solid rgba(231, 215, 196, 0.9);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-name {
            font-size: clamp(2.7rem, 4vw, 4.2rem);
            color: var(--fh-primary);
            font-weight: 700;
            line-height: 1;
            margin-bottom: 20px;
        }

        .brand-title {
            font-size: 1.2rem;
            color: #5d493b;
            margin-bottom: 10px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .brand-copy {
            max-width: 420px;
            color: var(--fh-muted);
            font-size: 1.02rem;
            line-height: 1.75;
        }

        .brand-panel {
            background: rgba(255, 255, 255, 0.58);
            border: 1px solid rgba(231, 215, 196, 0.95);
            border-radius: 24px;
            padding: 22px 24px;
        }

        .brand-panel-title {
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #876d5b;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .brand-panel-text {
            margin: 0;
            color: #5e4d40;
            line-height: 1.7;
        }

        .login-form-wrap {
            padding: 56px 48px;
            background: rgba(255, 253, 250, 0.92);
            display: flex;
            align-items: center;
        }

        .login-form {
            width: 100%;
        }

        .eyebrow {
            color: #8c7766;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-size: 0.82rem;
            font-weight: 700;
            margin-bottom: 14px;
        }

        h1 {
            margin: 0 0 10px;
            color: var(--fh-primary);
            font-size: clamp(2.2rem, 3vw, 3.1rem);
            line-height: 1.05;
            font-weight: 700;
        }

        .login-intro {
            margin: 0 0 30px;
            color: var(--fh-muted);
            line-height: 1.7;
        }

        .form-label {
            font-weight: 700;
            color: #584538;
            margin-bottom: 0.6rem;
        }

        .form-control {
            min-height: 56px;
            border-radius: 16px;
            border: 1px solid var(--fh-border);
            background: #fffdfa;
            padding: 0.95rem 1rem;
            font-size: 1rem;
        }

        .form-control:focus {
            border-color: rgba(210, 132, 69, 0.65);
            box-shadow: 0 0 0 0.2rem rgba(210, 132, 69, 0.14);
        }

        .btn-login {
            width: 100%;
            border: 0;
            border-radius: 16px;
            background: var(--fh-primary);
            color: #fff;
            padding: 1rem 1.1rem;
            font-weight: 700;
            font-size: 1rem;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .btn-login:hover {
            background: var(--fh-primary-dark);
            transform: translateY(-1px);
        }

        .alert-danger {
            border: 0;
            border-radius: 16px;
            background: var(--fh-danger-bg);
            color: var(--fh-danger-text);
            padding: 0.95rem 1rem;
            margin-bottom: 1.25rem;
        }

        @media (max-width: 991.98px) {
            .login-shell {
                grid-template-columns: 1fr;
            }

            .login-brand {
                border-right: 0;
                border-bottom: 1px solid rgba(231, 215, 196, 0.9);
                padding: 36px 28px;
                gap: 24px;
            }

            .login-form-wrap {
                padding: 36px 28px;
            }
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <section class="login-brand">
            <div>
                <div class="brand-name">FurHope</div>
                <div class="brand-title">Espace de connexion</div>
                <p class="brand-copy">
                    Accedez a votre espace client ou veterinaire pour gerer vos rendez-vous, vos disponibilites et vos suivis en toute simplicite.
                </p>
            </div>

            <div class="brand-panel">
                <div class="brand-panel-title">Acces securise</div>
                <p class="brand-panel-text">
                    Utilisez vos identifiants pour poursuivre la gestion de votre compte dans un environnement professionnel et centralise.
                </p>
            </div>
        </section>

        <section class="login-form-wrap">
            <div class="login-form">
                <div class="eyebrow">Authentification</div>
                <h1>Connexion</h1>
                <p class="login-intro">
                    Saisissez votre adresse email et votre mot de passe pour acceder a votre espace.
                </p>

                {% if error %}
                    <div class="alert alert-danger">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="POST" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label class="form-label" for="login-email">Adresse email</label>
                        <input
                            id="login-email"
                            type="email"
                            name="email"
                            class="form-control"
                            value="{{ last_username }}"
                            placeholder="nom@exemple.com"
                            required
                            autofocus
                        >
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="login-password">Mot de passe</label>
                        <input
                            id="login-password"
                            type="password"
                            name="password"
                            class="form-control"
                            placeholder="Votre mot de passe"
                            required
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn-login">Se connecter</button>
                </form>
            </div>
        </section>
    </div>
</body>
</html>
