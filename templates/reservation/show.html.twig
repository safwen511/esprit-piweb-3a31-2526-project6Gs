{% extends 'base.html.twig' %}

{% block title %}Reservation{% endblock %}

{% block body %}
    <div class="panel">
        <div class="section-heading">
            <h1>Reservation</h1>
            <div class="actions">
                <a class="button secondary" href="{{ path('app_reservation_index') }}">Back to list</a>
            </div>
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ reservation.id }}</td>
                </tr>
                <tr>
                    <th>Client ID</th>
                    <td>{{ reservation.clientId }}</td>
                </tr>
                <tr>
                    <th>Animal ID</th>
                    <td>{{ reservation.animalId }}</td>
                </tr>
                <tr>
                    <th>Hotel</th>
                    <td>{{ reservation.hotel ? reservation.hotel.name : '' }}</td>
                </tr>
                <tr>
                    <th>Start Date</th>
                    <td>{{ reservation.startDate ? reservation.startDate|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>End Date</th>
                    <td>{{ reservation.endDate ? reservation.endDate|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>{{ reservation.status }}</td>
                </tr>
            </tbody>
        </table>

        <div class="actions">
            {{ include('reservation/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
