{% extends 'base.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block body %}
    <div class="panel">
        <div class="section-heading">
            <h1>Reservations</h1>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Client ID</th>
                    <th>Animal ID</th>
                    <th>Hotel</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Reservation Date</th>
                    <th>Guest Count</th>
                    <th>Nightly Rate</th>
                    <th>Total Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.id }}</td>
                    <td>{{ reservation.clientId }}</td>
                    <td>{{ reservation.animalId }}</td>
                    <td>{{ reservation.hotel ? reservation.hotel.name : '' }}</td>
                    <td>{{ reservation.startDate ? reservation.startDate|date('Y-m-d') : '' }}</td>
                    <td>{{ reservation.endDate ? reservation.endDate|date('Y-m-d') : '' }}</td>
                    <td>
                        <span class="pill pill--{{ reservation.status|default('pending')|lower }}">
                            {{ reservation.status|default('PENDING') }}
                        </span>
                    </td>
                    <td>{{ reservation.createdAt ? reservation.createdAt|date('Y-m-d H:i') : '' }}</td>
                    <td>{{ reservation.reservationDate ? reservation.reservationDate|date('Y-m-d') : '' }}</td>
                    <td>{{ reservation.guestCount }}</td>
                    <td>{{ reservation.nightlyRate }}</td>
                    <td>{{ reservation.totalPrice }}</td>
                    <td>
                        <div class="actions">
                            {% if reservation.status != 'APPROVED' %}
                                <form method="post" action="{{ path('app_reservation_approve', {'id': reservation.id}) }}" style="display:inline;">
                                    <button class="button success" type="submit">Approve</button>
                                </form>
                            {% endif %}
                            {% if reservation.status != 'DECLINED' %}
                                <form method="post" action="{{ path('app_reservation_decline', {'id': reservation.id}) }}" style="display:inline;">
                                    <button class="button danger" type="submit">Decline</button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="13">
                        <div class="empty-state">
                            <h2>No data found</h2>
                            <p>There are currently no records available.</p>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
