# Committed development defaults only. Put real credentials in .env.local.
# Environment variables and .env.local override these values.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-env-local
APP_TIMEZONE=Africa/Tunis
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://127.0.0.1:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:root@127.0.0.1:3306/furhopeweb?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> meteo-concept/hcaptcha-bundle ###
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
###< meteo-concept/hcaptcha-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me-in-env-local
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM_EMAIL=noreply@furhope.local
BREVO_API_KEY=
###< symfony/mailer ###

###> app/password-reset ###
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_DEFAULT_COUNTRY_CODE=TN
TWILIO_DSN=null://null
###< app/password-reset ###

###> app/ai ###
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ACCOUNT_SUPPORT_GROQ_MODEL=llama-3.3-70b-versatile
###< app/ai ###

###> app/voice-auth ###
VOICE_SERVICE_BASE_URL=http://127.0.0.1:5001
###< app/voice-auth ###

###> app/stripe ###
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_CURRENCY=usd
###< app/stripe ###
