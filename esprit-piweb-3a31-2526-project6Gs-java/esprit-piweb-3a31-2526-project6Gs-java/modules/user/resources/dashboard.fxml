<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="modern-ui page dashboard-page"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardController">

    <left>
        <VBox spacing="16" fillWidth="true" styleClass="dashboard-sidebar" prefWidth="310" minWidth="285">
            <padding>
                <Insets top="24" right="18" bottom="24" left="18" />
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dashboard-brand-row">
                <SVGPath content="M 0 -10 C 6 -18 18 -14 18 -2 C 18 10 0 18 0 18 C 0 18 -18 10 -18 -2 C -18 -14 -6 -18 0 -10 Z" styleClass="dashboard-brand-icon"/>
                <VBox spacing="1">
                    <Label styleClass="dashboard-brand-title" text="FurHope" />
                    <Label styleClass="dashboard-brand-subtitle" text="Shelter operations" />
                </VBox>
            </HBox>

            <Separator />

            <VBox spacing="10" styleClass="dashboard-nav-list">
                <Button fx:id="reclamationButton" maxWidth="1.7976931348623157E308" onAction="#openReclamation" styleClass="sidebar-button dashboard-nav-button" text="Client Reclamation" />
                <Button fx:id="adminButton" maxWidth="1.7976931348623157E308" onAction="#goToAdmin" styleClass="sidebar-button dashboard-nav-button" text="Vet Approvals" />
                <Button fx:id="usersButton" maxWidth="1.7976931348623157E308" onAction="#goToUserAdmin" styleClass="sidebar-button dashboard-nav-button" text="User Management" />
                <Button fx:id="profileButton" maxWidth="1.7976931348623157E308" onAction="#goToProfile" styleClass="sidebar-button dashboard-nav-button" text="My Profile" />
            </VBox>

            <VBox spacing="10" styleClass="dashboard-sidebar-note">
                <Label text="Today" styleClass="dashboard-note-title"/>
                <Label text="Keep support, approvals, and account updates moving from one calm workspace."
                       wrapText="true"
                       styleClass="dashboard-note-copy"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Separator />
            <Button maxWidth="1.7976931348623157E308" onAction="#logout" styleClass="primary-button dashboard-bottom-button" text="Logout" />
            <Button maxWidth="1.7976931348623157E308" onAction="#goBack" styleClass="ghost-button dashboard-bottom-button" text="Back to Accueil" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="modern-ui page-scroll dashboard-scroll">
            <content>
                <VBox spacing="20" styleClass="dashboard-content dashboard-shell" maxWidth="1.7976931348623157E308">
                    <padding>
                        <Insets bottom="34" left="30" right="30" top="26" />
                    </padding>

                    <HBox spacing="24" alignment="CENTER_LEFT" styleClass="dashboard-hero-showcase">
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <Label text="Shelter Command Center" styleClass="dashboard-eyebrow"/>
                            <Label fx:id="welcomeLabel" styleClass="dashboard-welcome-title" />
                            <Label styleClass="dashboard-hero-copy"
                                   text="Control reclamations, veterinarian approvals, user access, and profile details from one warm operations desk."
                                   maxWidth="820"
                                   wrapText="true" />
                            <FlowPane hgap="10" vgap="10">
                                <Label text="Live support" styleClass="story-ribbon-chip"/>
                                <Label text="Approval workflow" styleClass="story-ribbon-chip"/>
                                <Label text="Shared Symfony data" styleClass="story-ribbon-chip"/>
                            </FlowPane>
                        </VBox>

                        <VBox spacing="10" prefWidth="330" minWidth="300" styleClass="dashboard-hero-panel">
                            <Label text="Quick Actions" styleClass="dashboard-panel-title"/>
                            <Button onAction="#openReclamation" styleClass="primary-button dashboard-panel-action" text="Open Reclamations" />
                            <Button onAction="#goToAdmin" styleClass="secondary-button dashboard-panel-action" text="Review Vet Requests" />
                            <Button onAction="#goToProfile" styleClass="secondary-button dashboard-panel-action" text="Edit Profile" />
                        </VBox>
                    </HBox>

                    <FlowPane hgap="14" vgap="14" prefWrapLength="1280" styleClass="dashboard-stat-grid">
                        <VBox spacing="4" styleClass="dashboard-stat-card">
                            <Label text="Support" styleClass="dashboard-stat-label"/>
                            <Label text="Reclamations" styleClass="dashboard-stat-value"/>
                            <Label text="Client messages and follow-up" styleClass="dashboard-stat-copy"/>
                        </VBox>
                        <VBox spacing="4" styleClass="dashboard-stat-card">
                            <Label text="Team" styleClass="dashboard-stat-label"/>
                            <Label text="Vet approvals" styleClass="dashboard-stat-value"/>
                            <Label text="Approve trusted care accounts" styleClass="dashboard-stat-copy"/>
                        </VBox>
                        <VBox spacing="4" styleClass="dashboard-stat-card">
                            <Label text="Identity" styleClass="dashboard-stat-label"/>
                            <Label text="Profile sync" styleClass="dashboard-stat-value"/>
                            <Label text="Same user data as Symfony" styleClass="dashboard-stat-copy"/>
                        </VBox>
                    </FlowPane>

                    <FlowPane hgap="18" vgap="18" prefWrapLength="1320" styleClass="dashboard-module-grid">
                        <VBox spacing="12" styleClass="dashboard-module-card" prefWidth="390" minWidth="340">
                            <SVGPath content="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" styleClass="dashboard-module-icon"/>
                            <Label styleClass="card-title" text="Client Reclamations" />
                            <Label styleClass="card-subtitle" text="Create tickets, follow responses, and keep users updated." wrapText="true" />
                            <Button onAction="#openReclamation" styleClass="primary-button dashboard-card-button" text="Open Reclamations" />
                        </VBox>

                        <VBox spacing="12" styleClass="dashboard-module-card" prefWidth="390" minWidth="340">
                            <SVGPath content="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10z M12 8v6 M9 11h6" styleClass="dashboard-module-icon"/>
                            <Label styleClass="card-title" text="Vet Approvals" />
                            <Label styleClass="card-subtitle" text="Review pending veterinarian accounts and activate care access." wrapText="true" />
                            <Button onAction="#goToAdmin" styleClass="secondary-button dashboard-card-button" text="Review Requests" />
                        </VBox>

                        <VBox spacing="12" styleClass="dashboard-module-card" prefWidth="390" minWidth="340">
                            <SVGPath content="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M9.5 7a4 4 0 1 0 0 .1 M22 21v-2a4 4 0 0 0-3-3.87" styleClass="dashboard-module-icon"/>
                            <Label styleClass="card-title" text="User Management" />
                            <Label styleClass="card-subtitle" text="Browse users, permissions, active accounts, and team details." wrapText="true" />
                            <Button onAction="#goToUserAdmin" styleClass="secondary-button dashboard-card-button" text="Manage Users" />
                        </VBox>

                        <VBox spacing="12" styleClass="dashboard-module-card" prefWidth="390" minWidth="340">
                            <SVGPath content="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" styleClass="dashboard-module-icon"/>
                            <Label styleClass="card-title" text="Profile" />
                            <Label styleClass="card-subtitle" text="Update your identity, contact details, and shared profile photo." wrapText="true" />
                            <Button onAction="#goToProfile" styleClass="secondary-button dashboard-card-button" text="Edit Profile" />
                        </VBox>
                    </FlowPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
