<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.AccueilController"
           stylesheets="@styles.css"
           styleClass="modern-ui page home-page">

    <ScrollPane fitToWidth="true" styleClass="modern-ui page-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <content>
            <VBox spacing="22" alignment="TOP_CENTER" styleClass="modern-ui page-content home-shell accueil-showcase">
                <padding>
                    <Insets top="26" right="30" bottom="38" left="30"/>
                </padding>

                <HBox spacing="28" alignment="CENTER" maxWidth="1420" styleClass="home-hero home-hero-content accueil-hero-showcase">
                    <VBox spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="home-hero-text accueil-hero-copy">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane styleClass="home-profile-avatar-shell">
                                <StackPane fx:id="profileAvatarFallback" styleClass="home-profile-avatar-fallback">
                                    <Circle radius="24" styleClass="home-profile-avatar-core" />
                                    <SVGPath content="M 0 -10 C 6 -18 18 -14 18 -2 C 18 10 0 18 0 18 C 0 18 -18 10 -18 -2 C -18 -14 -6 -18 0 -10 Z" styleClass="home-profile-avatar-heart"/>
                                </StackPane>
                                <ImageView fx:id="profileAvatarImageView"
                                           fitWidth="48"
                                           fitHeight="48"
                                           preserveRatio="false"
                                           managed="false"
                                           visible="false"
                                           styleClass="home-profile-avatar-image"/>
                            </StackPane>
                            <Label text="FurHope" styleClass="brand-title home-brand-title" />
                        </HBox>

                        <Label text="Where care finds its way home" styleClass="eyebrow accueil-eyebrow" />
                        <Label fx:id="welcomeLabel" text="Welcome to FurHope" styleClass="title home-hero-title accueil-hero-title" />
                        <Label text="Adoption stories, veterinary support, community updates, and shelter operations gathered into one warm, practical home."
                               wrapText="true"
                               maxWidth="780"
                               styleClass="subtitle home-hero-subtitle" />

                        <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT" styleClass="story-ribbon">
                            <Label text="Rescue follow-up" styleClass="story-ribbon-chip" />
                            <Label text="Gentle adoptions" styleClass="story-ribbon-chip" />
                            <Label text="Care teams in sync" styleClass="story-ribbon-chip" />
                        </FlowPane>

                        <FlowPane hgap="12" vgap="12" alignment="CENTER_LEFT">
                            <Button fx:id="signInButton" text="Sign In" styleClass="primary-button accueil-main-action" onAction="#goToSignIn" />
                            <Button fx:id="signUpButton" text="Create Account" styleClass="secondary-button accueil-main-action" onAction="#goToSignUp" />
                            <Button fx:id="dashboardButton" text="Open Dashboard" styleClass="primary-button accueil-main-action" onAction="#goToDashboard" />
                            <Button fx:id="profileButton" text="My Profile" styleClass="secondary-button accueil-main-action" onAction="#goToProfile" />
                            <Button fx:id="logoutButton" text="Logout" styleClass="ghost-button accueil-main-action" onAction="#logout" />
                        </FlowPane>

                        <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT" styleClass="hero-nav home-module-nav">
                            <Button text="Adoption" styleClass="nav-pill" onAction="#openAdoption"/>
                            <Button text="Products" styleClass="nav-pill" onAction="#openProducts"/>
                            <Button text="Vet Care" styleClass="nav-pill" onAction="#openVetCare"/>
                            <Button text="Social" styleClass="nav-pill" onAction="#openSocial"/>
                            <Button text="Hotel" styleClass="nav-pill" onAction="#openHostel"/>
                            <Hyperlink text="Donate to FurHope" styleClass="link-button" onAction="#openDonate"/>
                        </FlowPane>
                    </VBox>

                    <StackPane styleClass="card hero-slideshow accueil-photo-panel" prefWidth="500" minWidth="440" maxWidth="520">
                        <VBox spacing="12">
                            <StackPane styleClass="hero-photo-frame">
                                <ImageView fx:id="heroImageView" fitWidth="460" fitHeight="320" preserveRatio="false" styleClass="hero-photo"/>
                                <VBox alignment="BOTTOM_LEFT" spacing="4" styleClass="hero-photo-caption" StackPane.alignment="BOTTOM_LEFT">
                                    <Label text="Today at FurHope" styleClass="hero-photo-caption-title" />
                                    <Label text="A family visit, two health checks, and one first tail wag." wrapText="true" styleClass="hero-photo-caption-copy" />
                                </VBox>
                            </StackPane>
                            <HBox spacing="10" alignment="CENTER">
                                <Label text="" styleClass="hero-dot hero-dot-active" />
                                <Label text="" styleClass="hero-dot" />
                                <Label text="" styleClass="hero-dot" />
                            </HBox>
                        </VBox>
                    </StackPane>
                </HBox>

                <FlowPane hgap="16" vgap="16" alignment="CENTER" maxWidth="1420" prefWrapLength="1360" styleClass="quick-link-grid-java">
                    <VBox spacing="8" styleClass="quick-link-card-java">
                        <SVGPath content="M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z" styleClass="quick-link-icon-java"/>
                        <Label text="One dashboard" styleClass="card-title" />
                        <Label text="Move between care, social, hotel, products, and adoption without losing context." wrapText="true" styleClass="card-subtitle" />
                    </VBox>
                    <VBox spacing="8" styleClass="quick-link-card-java">
                        <SVGPath content="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10z" styleClass="quick-link-icon-java"/>
                        <Label text="Human stories" styleClass="card-title" />
                        <Label text="Follow animals from intake to adoption with updates that feel personal." wrapText="true" styleClass="card-subtitle" />
                    </VBox>
                    <VBox spacing="8" styleClass="quick-link-card-java">
                        <SVGPath content="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M9.5 7a4 4 0 1 0 0 .1 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75" styleClass="quick-link-icon-java"/>
                        <Label text="Team rhythm" styleClass="card-title" />
                        <Label text="Keep admins, vets, adopters, and support volunteers working from the same source." wrapText="true" styleClass="card-subtitle" />
                    </VBox>
                </FlowPane>

                <HBox spacing="22" alignment="TOP_CENTER" maxWidth="1420" styleClass="home-feature-band-java">
                    <VBox spacing="14" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" styleClass="card home-animals-section">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <Label text="Meet Our Friends" styleClass="section-title" />
                            <Label text="Ready for their next chapter" styleClass="subtitle" />
                        </HBox>

                        <FlowPane hgap="18" vgap="18" alignment="CENTER_LEFT" prefWrapLength="920">
                            <VBox spacing="10" alignment="CENTER" styleClass="animal-card home-animal-card accueil-friend-card">
                                <ImageView fx:id="friendLunaImageView" fitWidth="235" fitHeight="150" preserveRatio="false" styleClass="friend-photo"/>
                                <Label text="Luna" styleClass="card-title" />
                                <Label text="Gentle kitten, 4 months" styleClass="card-subtitle" />
                            </VBox>

                            <VBox spacing="10" alignment="CENTER" styleClass="animal-card home-animal-card accueil-friend-card">
                                <ImageView fx:id="friendBentoImageView" fitWidth="235" fitHeight="150" preserveRatio="false" styleClass="friend-photo"/>
                                <Label text="Bento" styleClass="card-title" />
                                <Label text="Playful pup, 1 year" styleClass="card-subtitle" />
                            </VBox>

                            <VBox spacing="10" alignment="CENTER" styleClass="animal-card home-animal-card accueil-friend-card">
                                <ImageView fx:id="friendMiloImageView" fitWidth="235" fitHeight="150" preserveRatio="false" styleClass="friend-photo"/>
                                <Label text="Milo" styleClass="card-title" />
                                <Label text="Senior buddy, calm" styleClass="card-subtitle" />
                            </VBox>
                        </FlowPane>
                    </VBox>

                    <VBox spacing="14" alignment="TOP_LEFT" styleClass="card home-info-card accueil-pulse-card" prefWidth="380" minWidth="340">
                        <Label text="Shelter Pulse" styleClass="section-title" />
                        <Label text="Track real operations with one clear control center."
                               wrapText="true"
                               styleClass="subtitle" />
                        <VBox spacing="12" styleClass="stat-grid">
                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="pulse-row">
                                <Label text="24/7" styleClass="stat-number" />
                                <Label text="Support for teams and adopters" styleClass="stat-label" />
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="pulse-row">
                                <Label text="Live" styleClass="stat-number" />
                                <Label text="Social feedback and notifications" styleClass="stat-label" />
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="pulse-row">
                                <Label text="Fast" styleClass="stat-number" />
                                <Label text="Reclamation follow-up workflow" styleClass="stat-label" />
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>

                <VBox fx:id="ctaSection" spacing="8" alignment="TOP_LEFT" maxWidth="1420" styleClass="card cta-section home-cta-section">
                    <Label fx:id="ctaTitleLabel" text="Ready to help?" styleClass="section-title" />
                    <Label fx:id="ctaBodyLabel"
                           text="Sign in to adopt animals, book vet care, and manage your shelter workflow from one dashboard."
                           styleClass="subtitle"
                           wrapText="true"/>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>
</StackPane>
